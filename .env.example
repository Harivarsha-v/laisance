# Copy to .env for local development. In production set these as real environment variables.
DEBUG=false
SECRET_KEY=generate-a-long-random-string
ALLOWED_HOSTS=your-app.onrender.com
CSRF_TRUSTED_ORIGINS=https://your-app.onrender.com

# SQL database (support tickets, FAQs, error codes, products, orders). Omit to use SQLite.
DATABASE_URL=postgres://user:password@host:5432/dbname

# MongoDB Atlas (chat logs + feedback)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=laisance

# Exchange-rate API (third-party, time-limited with fallback)
CURRENCY_API_URL=https://api.frankfurter.app/latest
CURRENCY_API_KEY=
CURRENCY_API_TIMEOUT=2.5

AI_RATE_LIMIT=20
MAINTENANCE_MODE=false
